# ==============================================================================
# TRACE Local Environment Configuration Example
# Copy this file to .env and adjust placeholder values for your local environment.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# PostgreSQL async connection string (required)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/trace

# Neo4j Bolt connection URI (optional; required if Neo4j is enabled)
NEO4J_URI=bolt://localhost:7687

# Neo4j authentication username (optional)
NEO4J_USERNAME=neo4j

# Neo4j authentication password (optional)
NEO4J_PASSWORD=password

# OpenRouter API key for LLM calls (optional; required if LLM_ENABLE_EXTERNAL_CALLS=true)
OPENROUTER_API_KEY=

# OpenRouter API base URL endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default free-tier LLM model identifier (free-first policy)
LLM_DEFAULT_MODEL=mistralai/mistral-7b-instruct:free

# Heavy reasoning LLM model identifier (optional)
LLM_REASONING_MODEL=

# Low-latency fast LLM model identifier (optional)
LLM_FAST_MODEL=

# Comma-separated list of fallback model identifiers (optional)
LLM_FALLBACK_MODELS=

# Vector store connection endpoint URL (optional; Phase 4+)
VECTOR_STORE_URL=

# Application environment: development | production | test
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Boolean flag to permit live external LLM calls (default: false)
LLM_ENABLE_EXTERNAL_CALLS=false

# Boolean flag to permit sending repository source code to external LLMs (default: false)
LLM_ENABLE_EXTERNAL_TRANSMISSION=false
